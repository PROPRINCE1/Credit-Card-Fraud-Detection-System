# Copy to backend/.env. Never commit backend/.env.
# Copy the exact Session pooler URI from Supabase > Connect (port 5432).
# Percent-encode special characters in the password; keep the real value local.
DATABASE_URL="postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require"
# For SQLite instead, comment out DATABASE_URL above (default: project/creditguard.db).
